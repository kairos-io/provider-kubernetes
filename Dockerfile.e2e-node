# Dockerfile.e2e-node -- a kind-style "systemd-as-PID1 node container" for the
# provider-kubernetes e2e harness (ADR-13, slice E2).
#
# It FROM-derives a built kairos-kubeadm image so it REUSES the
# checksum-verified toolchain (kubeadm / kubelet / kubectl / containerd / runc /
# CNI) already baked there -- nothing is re-downloaded here. That includes the
# static etcdctl / etcdutl at /usr/bin, extracted from the cosign-verified etcd
# image by the base build (ADR-12-A1), which the e2e suite execs. We only add the
# tweaks a real kubeadm+kubelet+containerd need to run inside a privileged
# container on cgroup v2 with the systemd cgroup driver, mirroring the
# upstream-blessed kind node-image pattern.
#
# Build (via the Makefile, which sets BASE_IMAGE for you):
#   make e2e-node-image KUBERNETES_VERSION=v1.37.0
# or directly:
#   docker build \
#     --build-arg BASE_IMAGE=kairos-kubeadm:v1.37.0 \
#     -f Dockerfile.e2e-node -t kairos-kubeadm-e2e-node:v1.37.0 .
#
# Run (the harness does this for you; recorded here for reference):
#   docker run -d --privileged \
#     --cgroupns=private \
#     --tmpfs /run --tmpfs /tmp \
#     -v /var/lib/containerd -v /var/lib/kubelet -v /var/lib/etcd \
#     --entrypoint /sbin/init \
#     kairos-kubeadm-e2e-node:v1.37.0

ARG BASE_IMAGE=kairos-kubeadm:v1.37.0
FROM ${BASE_IMAGE}

# kubeadm refuses to run with swap on by default; a container has no swap, but be
# explicit and disable the kubelet's swap-detection nuisance the way kind does.
ENV container=docker

# --- kind systemd-in-container tweaks -------------------------------------
# 1. Mask units that are meaningless or harmful inside a container (they try to
#    touch real hardware / the host kernel and would fail or hang). This started
#    as the set kind masks in its node image entrypoint, plus the audit units
#    below, which kind does not need because it does not ship auditd.
# 2. Ensure the journal goes to a writable location and systemd does not try to
#    set up a separate cgroup hierarchy (we run cgroup v2 unified, delegated).
#
# Nothing here enables containerd or the kubelet. The base image ships them in
# /usr/lib/systemd/system with relative multi-user.target.wants links and no
# [Install] section (ADR-19 U2), so `systemctl enable` would fail; the
# `|| true` it used to carry would have hidden exactly the regression this
# derived image has to prove absent, which is why S19-11 has the e2e node image
# checked by scripts/verify-image-files.sh too.
RUN set -eux; \
    # Units that must not run in a container.
    for unit in \
      systemd-udevd.service \
      systemd-udevd-kernel.socket \
      systemd-udevd-control.socket \
      systemd-modules-load.service \
      sys-kernel-config.mount \
      sys-kernel-debug.mount \
      sys-kernel-tracing.mount \
      systemd-journald-audit.socket \
      auditd.service \
      audit-rules.service ; do \
        systemctl mask "$unit" || true; \
    done; \
    # Do not let getty/console units spin.
    systemctl mask getty.target console-getty.service || true

# Why auditd.service and audit-rules.service are masked above (R-E2E-CONTAINERD).
# The kernel audit subsystem is host-global, so a container cannot enable it:
# auditd logs "Unable to set initial audit startup state to 'enable', exiting",
# and has been seen to segfault. On most boots it fails fast and nothing notices
# -- a healthy e2e node reports auditd.service and audit-rules.service in
# `systemctl list-units --state=failed` while containerd runs normally.
#
# Intermittently it does NOT fail fast. It hangs for its whole TimeoutStartSec
# and systemd logs "auditd.service: start operation timed out. Terminating.",
# and containerd's start job sits queued behind it for that window. That is what
# made `waitFor("containerd admin API ready", 90s)` in test/e2e/nodecontainer.go
# time out on a container whose containerd journal was "-- No entries --":
# containerd had never been started, so it was never slow. It cost roughly one
# e2e leg in three, on a different Kubernetes minor each time.
#
# Masking is the fix rather than a larger readiness budget, because the units can
# never do anything useful here and already fail on every boot. Deliberately NOT
# masked: systemd-networkd-wait-online.service, which also shows up failed. It is
# a wait-online unit, so masking it would let network-online.target be reached
# immediately and could start containerd or the kubelet before networking is
# ready -- trading this flake for a subtler one.

# The kubelet must not be gated on swap; kind passes failSwapOn=false via the
# kubelet config. kubeadm in the supported window handles swap by default, but a privileged
# container can momentarily see host swap, so we belt-and-braces the flag through
# the kubeadm extra-args drop-in the unit already sources (/etc/default/kubelet).
RUN set -eux; \
    mkdir -p /etc/default; \
    printf 'KUBELET_EXTRA_ARGS=--fail-swap-on=false\n' > /etc/default/kubelet

# Declare the stateful directories as volumes so each container run gets a fresh,
# isolated, writable layer for them (kind keeps these out of the image layer for
# correctness and teardown). The harness also passes anonymous -v for these.
VOLUME [ "/var/lib/containerd", "/var/lib/kubelet", "/var/lib/etcd" ]

# systemd is PID 1. The kairos base image is systemd-based, so /sbin/init is
# systemd. STOPSIGNAL SIGRTMIN+3 is systemd's clean-shutdown signal (kind uses
# the same), so `docker stop` shuts the node down gracefully.
STOPSIGNAL SIGRTMIN+3
ENTRYPOINT [ "/sbin/init" ]
